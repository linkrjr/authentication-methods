# Copied to .env by `bun scripts/ensure-env.ts`; __GENERATE__ values become 32 random bytes (base64).
PORT=3000
APP_ORIGIN=http://localhost:5173
# DATABASE_PATH=./data/app.sqlite
# COOKIE_SECURE=true          # defaults to true when NODE_ENV=production
# TRUST_PROXY_HOPS=1          # only behind a reverse proxy you control
# AUTH_RATE_LIMIT_MAX=30      # auth requests per IP per 15 minutes

PASSWORD_PEPPER=__GENERATE__
ENCRYPTION_KEY=__GENERATE__
JWT_SECRET=__GENERATE__

# Mock OAuth 2.0 authorization server ("DemoID") started alongside the API.
OAUTH_PROVIDER_PORT=4000
OAUTH_PROVIDER_URL=http://localhost:4000
OAUTH_DEMO_CLIENT_ID=auth-patterns-demo
OAUTH_DEMO_CLIENT_SECRET=__GENERATE__
